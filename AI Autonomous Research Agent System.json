      "parameters": {
        "jsCode": "const article = $json.data || $json.body || \"\";\n\nconst cleanedArticle = article\n  .replace(/\\n+/g, \"\\n\")\n  .replace(/\\s+/g, \" \")\n  .trim()\n  .substring(0, 12000);\n\nreturn [\n  {\n    json: {\n      searchQuery: $('Extract Search Results').item.json.searchQuery,\n      title: $('Extract Search Results').item.json.title,\n      url: $('Extract Search Results').item.json.url,\n      article: cleanedArticle\n    }\n  }\n];"
      },
