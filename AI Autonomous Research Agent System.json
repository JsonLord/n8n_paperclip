        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert AI research analyst.\n\nAnalyze multiple research article summaries.\n\nYour job:\n- identify common trends\n- compare findings\n- detect repeated insights\n- identify important tools/platforms\n- generate professional research conclusions\n\nReturn ONLY valid JSON.\n\nNo markdown.\nNo explanation."
            },
            {
              "content": "=Analyze these research summaries:\n\n{{ JSON.stringify($json.articles) }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "b0345d53-4a3e-44d7-a444-aaa357433c4e",
      "name": "Analyze Research Insights",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        3760,
        368
      ],
      "typeVersion": 2.1
    },
    {
      "parameters": {
        "jsCode": "const rawText = $json.output[0].content[0].text;\n\nconst data = JSON.parse(rawText);\n\nconst report = `\n# AI Research Report\n\n## Common Trends\n${data.commonTrends.map(t => `- ${t}`).join('\\n')}\n\n## Compared Findings\n${Object.entries(data.comparedFindings)\n  .map(([k,v]) => `### ${k}\\n${v}`)\n  .join('\\n\\n')}\n\n## Repeated Insights\n${data.repeatedInsights.map(i => `- ${i}`).join('\\n')}\n\n## Important Tools\n${data.importantToolsPlatforms\n  .map(t => `- ${t.name}: ${t.useCase}`)\n  .join('\\n')}\n\n## Final Conclusion\n${data.professionalResearchConclusions}\n`;\n\nreturn [{\n  json: {\n    report\n  }\n}];"
      },
      "id": "55eff2e6-db8a-461d-a5cb-7b6711b88b75",
      "name": "Create Final Research Report",
      "type": "n8n-nodes-base.code",
      "position": [
        4080,
        368
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const report = $json.report;\n\nconst html = `\n<html>\n<head>\n  <style>\n    body {\n      font-family: Arial;\n      padding: 30px;\n      line-height: 1.6;\n    }\n    h1 {\n      color: #222;\n    }\n    h2 {\n      color: #444;\n      margin-top: 25px;\n    }\n  </style>\n</head>\n<body>\n${report\n  .replace(/^# (.*$)/gim, '<h1>$1</h1>')\n  .replace(/^## (.*$)/gim, '<h2>$1</h2>')\n  .replace(/^### (.*$)/gim, '<h3>$1</h3>')\n  .replace(/^\\- (.*$)/gim, '<li>$1</li>')\n  .replace(/\\n/g, '<br>')}\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    html\n  }\n}];"
      },
